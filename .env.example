# Optional cloud sync. Without these values the app falls back to local browser storage.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Visitor door code. The keypad supports anti-peep input: extra digits may be typed before/after this code.
NEXT_PUBLIC_DOOR_CODE=0520

# Owner Mode editing passcode. This is an editing guard, not cryptographic protection.
NEXT_PUBLIC_OWNER_PIN=2027
