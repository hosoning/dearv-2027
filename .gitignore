# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Godot private game build/cache
/game/.godot/
/game/builds/
/game/export_presets.cfg
/game/config/local.cfg

# Blender temporary and backup files
*.blend1
*.blend2
*.blend@
/game/assets/**/*.blend
/game/assets/materials/
/game/assets/previews/
